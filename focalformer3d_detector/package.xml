<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>focalformer3d_detector</name>
  <version>0.1.0</version>
  <description>ROS 2 package integrating the official FocalFormer3D implementation by NVlabs</description>

  <maintainer email="vankempen@thinking-cars.de">Raphael van Kempen</maintainer>
  <author email="vankempen@thinking-cars.de">Raphael van Kempen</author>

  <license>Apache-2.0</license>

  <depend>perception_msgs</depend>
  <depend>perception_msgs_utils</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>python3-numpy</depend>

  <!-- model dependencies (torch, mmcv-full, mmdet, mmdetection3d) are not resolvable
       via rosdep and must be installed manually, see README -->

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
